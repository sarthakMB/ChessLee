# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-in-production

# PostgreSQL Configuration (use Docker service names)
DATABASE_URL=postgresql://chess_user:chess_password@postgres:5432/chess_dev
PG_POOL_MAX=20

# Redis Configuration (use Docker service names)
REDIS_URL=redis://redis:6379

# Logging
# PINO: verbose (full details) | compact (minimal, default in dev)
PINO=compact
# DEBUG: app:* | app:routes:* | app:services:* | app:repo:* | app:db:*
DEBUG=app:*
