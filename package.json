{
  "name": "chess_app",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.mjs",
  "scripts": {
    "start": "node -r dotenv/config src/app.mjs",
    "dev": "NODE_ENV=development nodemon -r dotenv/config --watch src --ext mjs,js src/app.mjs",
    "dev:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/css/output.css --watch",
    "migrate": "node db/migrations/migrate.mjs",
    "dump-schema": "docker-compose exec postgres pg_dump -U chess_user -d chess_dev --schema-only --no-owner > db/schema.sql",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:ws": "node scripts/ws-smoke-test.mjs",
    "test:ws:single": "node scripts/ws-test-single-player.mjs",
    "test:ws:multi": "node scripts/ws-test-two-player.mjs",
    "test:ws:auth": "node scripts/ws-test-authorization.mjs"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "bcrypt": "^6.0.0",
    "chess.js": "^1.4.0",
    "connect-redis": "^9.0.0",
    "debug": "^4.4.3",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "pg": "^8.16.3",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "socket.io-client": "^4.8.3"
  }
}
